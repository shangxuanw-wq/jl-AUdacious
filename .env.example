# 全部設在 Vercel 專案的 Environment Variables（密鑰勾 Sensitive）。這裡只是清單，不放真值。
RFQ_DATABASE_URL=postgresql://postgres.<ref>:<密碼>@aws-<region>.pooler.supabase.com:5432/postgres
SESSION_SECRET=<64 個隨機字元>
GOOGLE_CLIENT_ID=<Google OAuth 用戶端 ID>
GOOGLE_CLIENT_SECRET=<Google OAuth 用戶端密鑰>
ALLOWED_EMAILS=shangxuanw@gmail.com
APP_BASE_URL=https://jl-audacious.vercel.app
AUD_QUOTE_API_URL=internal-mock   # 開發期：送到 app 內的假澳得仕；正式對接時改成澳得仕網址
AUD_QUOTE_API_TOKEN=<跟 MOCK_AUD_TOKEN 同一組（開發期）>
MOCK_AUD_TOKEN=<≥24 字元>
# RFQ_ALLOW_PARTNER_PROD=true   ← 只有正式對接澳得仕時才設
# 臨時登入金鑰（Google 登入設定好之前用；至少 24 字元）
APP_ACCESS_KEY=
# 雲端自我測試（驗證完拿掉；至少 24 字元）
SELFTEST_KEY=
# 每天 Vercel Cron 的密鑰（至少 16 字元）
CRON_SECRET=
